\@writefile{toc}{\contentsline {section}{\numberline {2}New Approaches: The ATLAZ Architecture}{3}{section.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {{2.1}}Data Ingestion and Substitution Kernels}{3}{subsection.2.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Graphical Abstract: Resolving the Bifurcation Constraint.} Traditional phylogenetic models (Panel A) force genomic lineages into strict bifurcating trees, leading to mathematical failures when presented with reticulate events like horizontal gene transfer or recombination. The ATLAZ geometric engine (Panel B) represents sequence space as a topological metric space, perfectly preserving $H_1$ homology loops and explicitly mapping evolutionary reticulation.}}{4}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:graphical_abstract}{{1}{4}{\textbf {Graphical Abstract: Resolving the Bifurcation Constraint.} Traditional phylogenetic models (Panel A) force genomic lineages into strict bifurcating trees, leading to mathematical failures when presented with reticulate events like horizontal gene transfer or recombination. The ATLAZ geometric engine (Panel B) represents sequence space as a topological metric space, perfectly preserving $H_1$ homology loops and explicitly mapping evolutionary reticulation}{figure.caption.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {ATLAZ System Architecture.} Raw FASTA/FASTQ data is ingested via zero-copy memory mapping (\texttt  {mmap}) directly into L1/L2 cache-aligned Struct-of-Arrays (SoA). The core Vietoris-Rips filtration and subsequent GF(2) matrix reduction are managed within a strictly bounded $O(1)$ Arena Allocator. This pipeline entirely bypasses the memory deserialization and Garbage Collection (GC) overheads that cause fatal Out-Of-Memory (OOM) crashes in legacy interpreted languages like Python and R.}}{4}{figure.caption.2}\protected@file@percent }
\newlabel{fig:architecture}{{2}{4}{\textbf {ATLAZ System Architecture.} Raw FASTA/FASTQ data is ingested via zero-copy memory mapping (\texttt {mmap}) directly into L1/L2 cache-aligned Struct-of-Arrays (SoA). The core Vietoris-Rips filtration and subsequent GF(2) matrix reduction are managed within a strictly bounded $O(1)$ Arena Allocator. This pipeline entirely bypasses the memory deserialization and Garbage Collection (GC) overheads that cause fatal Out-Of-Memory (OOM) crashes in legacy interpreted languages like Python and R}{figure.caption.2}{}}
