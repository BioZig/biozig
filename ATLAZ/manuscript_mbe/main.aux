\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {Empirical Viral Datasets and ATLAZ Topological Invariants.}}}{6}{table.caption.3}\protected@file@percent }
\newlabel{tab:datasets}{{1}{6}{\textbf {Empirical Viral Datasets and ATLAZ Topological Invariants.}}{table.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Persistence Barcode of Clonal Evolution (Ebola Virus).} The Vietoris-Rips filtration of the Ebola cohort ($N=710$) yields an absolute zero Betti 1 number ($\beta _1=0$). The isolated $H_0$ components merge linearly, geometrically proving the absence of any structural reticulation or homologous recombination within the sampled transmission chains.}}{6}{figure.caption.4}\protected@file@percent }
\newlabel{fig:ebola_clonal}{{3}{6}{\textbf {Persistence Barcode of Clonal Evolution (Ebola Virus).} The Vietoris-Rips filtration of the Ebola cohort ($N=710$) yields an absolute zero Betti 1 number ($\beta _1=0$). The isolated $H_0$ components merge linearly, geometrically proving the absence of any structural reticulation or homologous recombination within the sampled transmission chains}{figure.caption.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {{3.2}}Exposing Dense Reticulation: Hepatitis B (HBV) and Avian Influenza}{6}{subsection.3.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Topological Contour Map of HBV Reticulation.} Heatgrid mapping of the Hepatitis B persistent homology reveals a massive structural anomaly: a dense cluster of high-persistence $H_1$ topological loops ($\beta _1 = 843$), indicative of intense inter-genotypic homologous recombination.}}{7}{figure.caption.5}\protected@file@percent }
\newlabel{fig:hbv_reticulate}{{4}{7}{\textbf {Topological Contour Map of HBV Reticulation.} Heatgrid mapping of the Hepatitis B persistent homology reveals a massive structural anomaly: a dense cluster of high-persistence $H_1$ topological loops ($\beta _1 = 843$), indicative of intense inter-genotypic homologous recombination}{figure.caption.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {{3.3}}Topological Selection Score (TSS) and Structural Rigidity}{7}{subsection.3.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Topological Realization of Recombination (HBV).} Geometric projection of the HBV cohort sequence space clearly isolating the structural $H_1$ generator. This central topological void provides explicit mathematical evidence of a macro-evolutionary reticulation event bridging distinct genetic clusters.}}{8}{figure.caption.6}\protected@file@percent }
\newlabel{fig:hbv_3d}{{5}{8}{\textbf {Topological Realization of Recombination (HBV).} Geometric projection of the HBV cohort sequence space clearly isolating the structural $H_1$ generator. This central topological void provides explicit mathematical evidence of a macro-evolutionary reticulation event bridging distinct genetic clusters}{figure.caption.6}{}}
